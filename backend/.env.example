MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chantier360?appName=Chantier360
JWT_SECRET=<long random string>
PORT=4000
# Comma-separated web origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
# Public base URL of this API (used to build photo links). Optional locally.
PUBLIC_URL=

# Optional: permanent photo storage (free Cloudinary account). Without these, photos are lost on each Render deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
